; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ailley4.3"
run/main_scene="uid://6ototcf3lfbk"
config/auto_accept_quit=false
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
GameClock="*res://scripts/core/GameClock.gd"
AIService="*res://scripts/ai/ai_service.gd"
SaveService="*res://scripts/save/json_save_service.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
DatabaseManager="*res://scripts/database/DatabaseManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/TileMapDual/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://scenes/": "green"
}

[gui]

theme/custom="res://assets/ui/ailley_theme.tres"
theme/custom_font="res://assets/fonts/Cubic_11.ttf"

