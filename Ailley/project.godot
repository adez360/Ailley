[internationalization]

locale/translations=["res://locale/game.zh_TW.translation", "res://locale/game.en.translation", "res://locale/console.zh_TW.translation", "res://locale/console.en.translation"]
locale/fallback="zh_TW"

[layer_names]

2d_physics/layer_1="terrain"
2d_physics/layer_2="character"
2d_physics/layer_3="interactable"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
