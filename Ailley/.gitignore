# ============================================
# Godot 4.x 專案 .gitignore（多人協作版）
# ============================================

# ---- Godot 4 核心 ----
# .godot/ 存放編輯器快取、匯入後的資源、UID 索引，
# 每個人的機器上內容都不同，絕對不能進版控，
# 也是多人協作最常見的衝突來源。
.godot/
.godot/**

# 匯出設定（含簽章金鑰路徑等機敏資訊，不共用）
export.cfg
export_credentials.cfg

# 自動產生的翻譯快取
*.translation

# ---- C#/.NET（如果之後有人加 C# 模組）----
.mono/
data_*/
mono_crash.*.json
*.csproj.user

# ---- 打包輸出 ----
builds/
exports/
*.exe
*.pck
*.zip
*.dmg
*.apk
*.aab

# ---- 編輯器 / IDE ----
.vscode/
.vs/
.idea/
*.swp
*.swo

# ---- 作業系統 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Ailley 專案專屬：Python 對話系統 ----
__pycache__/
*.pyc
.venv/
venv/
.env
*.log

# ---- 其他暫存檔 ----
*.tmp
*.bak
