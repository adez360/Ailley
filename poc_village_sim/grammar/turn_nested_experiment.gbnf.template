root ::= "{" ws "\"emotion\"" ws ":" ws emotion ws "," ws "\"intent\"" ws ":" ws intent ws "," ws "\"inner_monologue\"" ws ":" ws string ws "," ws "\"speech\"" ws ":" ws nullable-string ws "," ws "\"speech_volume\"" ws ":" ws speech-volume ws "}"

# 2026-08-06：巢狀動作分類實驗（跟 turn_duration_experiment.gbnf.template 對照）。
# 假設：先讓模型 commit 一個「現在最需要的類別」（生理/社交/工作/動作），grammar 逐 token
# 生成時會把這個 commit 當成後續選 action 的隱性條件，比一次從 38 個扁平選項裡選一個更穩，
# 效果類似之前 intent 欄位順序調整（先 intent 再獨白）解決敘事脫節的機制。
# 用 category+action 配對成四條獨立規則（而非「category 任填、action 任填」兩個獨立欄位），
# 是為了讓 grammar 結構上就保證 category 與 action 一致，不需要引擎事後核對。
# action 分類清單（需求導向，非原本的「機制導向」五分法）：
# - 生理：吃飯、喝酒、治療、睡覺
# - 社交：說話、喊話、悄悄話、握手、擁抱、送禮、給錢、結婚、離婚、跟隨、展示物品、飛吻、
#   偷竊、搶劫、破壞樂器、攻擊、抓捕、舉報
# - 工作：打獵、採草藥、釣魚、表演、買東西、賣東西、巡邏
# - 動作：移動、奔跑、蹲下、抱頭、舉手、大叫、摔東西、自首、發呆

intent ::= physio-intent | social-intent | work-intent | move-intent

physio-intent ::= "{" ws "\"action_category\"" ws ":" ws "\"生理\"" ws "," ws "\"action\"" ws ":" ws physio-action ws "," ws "\"duration_minutes\"" ws ":" ws duration ws "," ws "\"target\"" ws ":" ws target-value ws "," ws "\"location\"" ws ":" ws location-value ws "}"
social-intent ::= "{" ws "\"action_category\"" ws ":" ws "\"社交\"" ws "," ws "\"action\"" ws ":" ws social-action ws "," ws "\"duration_minutes\"" ws ":" ws duration ws "," ws "\"target\"" ws ":" ws target-value ws "," ws "\"location\"" ws ":" ws location-value ws "}"
work-intent ::= "{" ws "\"action_category\"" ws ":" ws "\"工作\"" ws "," ws "\"action\"" ws ":" ws work-action ws "," ws "\"duration_minutes\"" ws ":" ws duration ws "," ws "\"target\"" ws ":" ws target-value ws "," ws "\"location\"" ws ":" ws location-value ws "}"
move-intent ::= "{" ws "\"action_category\"" ws ":" ws "\"動作\"" ws "," ws "\"action\"" ws ":" ws move-action ws "," ws "\"duration_minutes\"" ws ":" ws duration ws "," ws "\"target\"" ws ":" ws target-value ws "," ws "\"location\"" ws ":" ws location-value ws "}"

duration ::= [1-9] [0-9]? [0-9]?

emotion ::= "\"excited\"" | "\"happy\"" | "\"in_love\"" | "\"terrified\"" | "\"burnout\"" | "\"angry\"" | "\"sad\"" | "\"neutral\""

speech-volume ::= "\"normal\"" | "\"shout\"" | "\"whisper\""

physio-action ::= "\"吃飯\"" | "\"喝酒\"" | "\"治療\"" | "\"睡覺\""
social-action ::= "\"說話\"" | "\"喊話\"" | "\"悄悄話\"" | "\"握手\"" | "\"擁抱\"" | "\"送禮\"" | "\"給錢\"" | "\"結婚\"" | "\"離婚\"" | "\"跟隨\"" | "\"展示物品\"" | "\"飛吻\"" | "\"偷竊\"" | "\"搶劫\"" | "\"破壞樂器\"" | "\"攻擊\"" | "\"抓捕\"" | "\"舉報\""
work-action ::= "\"打獵\"" | "\"採草藥\"" | "\"釣魚\"" | "\"表演\"" | "\"買東西\"" | "\"賣東西\"" | "\"巡邏\""
move-action ::= "\"移動\"" | "\"奔跑\"" | "\"蹲下\"" | "\"抱頭\"" | "\"舉手\"" | "\"大叫\"" | "\"摔東西\"" | "\"自首\"" | "\"發呆\""

nullable-string ::= "null" | string
string ::= "\"" ([^"\\] | "\\" ["\\/bfnrt])* "\""
ws ::= [ \t\n]*
